POSTGRES_USER=genesis_admin
POSTGRES_PASSWORD=genesis_strong_pass_2026
POSTGRES_DB=genesis_db
SECRET_KEY=genesis_jwt_secret_2026_prod_change_me
ADMIN_SECRET_KEY=genesis_admin_master_2026

# Multi-Tier Failover & Backup Settings (5s snapshot cadence)
SNAPSHOT_INTERVAL_SECONDS=5.0
AUTO_RESTORE_ON_BOOT=true
STANDBY_SYNC_URL=
PRIMARY_SYNC_URL=
STANDBY_SYNC_SECRET=genesis_standby_sync_2026

# Tier-3 Off-Site Supabase Cloud Backup Vault (Optional - zero impact on trade latency)
# Option A (Zero SQL setup): Paste Supabase Postgres Transaction/Session Pooler URI
SUPABASE_DB_URL=
# Option B (Firewall-proof HTTPS 443): Paste Supabase Project URL + Service Role Key (run scripts/supabase_schema.sql)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_SNAPSHOT_TABLE=genesis_snapshots

# AWS Single-EC2 Production Deployment Options (Free-Tier Friendly)
# Use ./nginx/nginx.http.conf behind AWS ALB/CloudFront TLS or direct IP tests; default ./nginx/nginx.conf for Port 443 SSL
NGINX_CONF=./nginx/nginx.conf
CORS_ORIGINS=*
S3_BACKUP_BUCKET=
VITE_API_URL=
VITE_WS_URL=
VITE_FALLBACK_URLS=

