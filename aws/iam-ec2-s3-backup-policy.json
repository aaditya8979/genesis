{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GenesisSnapshotBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::YOUR_GENESIS_BACKUP_BUCKET"
    },
    {
      "Sid": "GenesisSnapshotBucketReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_GENESIS_BACKUP_BUCKET/*"
    }
  ]
}

